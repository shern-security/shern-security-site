# Remote State Configuration
# 
# This configures S3 + DynamoDB backend for remote state storage and locking.
# Required for CI/CD deployments (GitHub Actions).
#
# NOTE: This backend is ONLY used by GitHub Actions with IAM user credentials.
# For local development with AWS SSO (aws login), use local state instead.
#
# SETUP INSTRUCTIONS:
# 1. Create state bucket (one-time):
#    aws s3 mb s3://shern-terraform-state-2025
#    aws s3api put-bucket-versioning --bucket shern-terraform-state-2025 --versioning-configuration Status=Enabled
#    aws s3api put-bucket-encryption --bucket shern-terraform-state-2025 --server-side-encryption-configuration '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}'
#
# 2. Create DynamoDB lock table (one-time):
#    aws dynamodb create-table --table-name terraform-state-lock --attribute-definitions AttributeName=LockID,AttributeType=S --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST --region us-east-1
#
# 3. This file is disabled locally. GitHub Actions workflow automatically enables it.

terraform {
  backend "s3" {
    bucket         = "shern-terraform-state-2025"
    key            = "website/terraform.tfstate"
    region         = "us-east-1"
    encrypt        = true
    dynamodb_table = "terraform-state-lock"
  }
}
