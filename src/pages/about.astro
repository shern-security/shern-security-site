---
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About - Shern Security',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero tagline="About">
    <Fragment slot="title">
      Jon Shern<br />
      <span class="text-accent dark:text-white highlight">Cybersecurity Leader</span>
    </Fragment>

    <Fragment slot="subtitle">
      Enterprise Security Leader with 15+ years of experience guiding organizations through complex security transformations.
      Known as a positive, people-first coach who helps teams transition from traditional security models to modern,
      engineering-driven approaches such as Infrastructure and Security as Code.
    </Fragment>
  </Hero>
</Layout>
