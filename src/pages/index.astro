---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';
import heroImage from '~/assets/images/lighthouse-hero.jpg';

const metadata = {
  title: 'Shern Security - Professional Cybersecurity Services',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'View Resume',
        href: getPermalink('/resume'),
      },
      { text: 'Learn More', href: '#services' },
    ]}
    image={{
      src: heroImage,
      alt: 'Split Rock Lighthouse - Beacon of Light',
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white highlight">A Beacon of Light</span> in Cybersecurity
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <strong>Self-service security enables IT and Business.</strong> Like a lighthouse guiding ships safely to shore, Shern Security makes the secure way the easy way.
      </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">Shern Security</span>
      15+ years of security leadership, automation by example, and engineering-driven approaches that empower teams to move fast securely.
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->
  <Features
    id="services"
    tagline="Core Principles"
    title="Making the Secure Way the Easy Way"
    subtitle="Self-service security enables IT and Business to move fast while staying secure. Automation by example, infrastructure as code, and engineering-driven approaches that eliminate bottlenecks."
    items={[
      {
        title: 'Self-Service Security',
        description:
          'Enable teams to move fast through automation, pull requests, and approval gates. Security gets out of the way while staying in control.',
      },
      {
        title: 'Automation by Example',
        description:
          'Teaching through working code. Real Terraform examples, GitHub Actions pipelines, and documentation that teams can fork and adapt.',
        icon: 'tabler:code',
      },
      {
        title: 'Infrastructure as Code',
        description:
          'Everything as code: Security groups, access packages, conditional access policies, and firewall rules. Version controlled, peer reviewed, automated.',
        icon: 'tabler:git-branch',
      },
      {
        title: 'Identity & Access Management',
        description:
          'Enterprise IAM with Entra ID automation, access packages, SSO, Conditional Access, and Privileged Access Management for 80K+ users.',
        icon: 'tabler:key',
      },
      {
        title: 'Cloud Security Engineering',
        description:
          'AWS and Azure security architecture, serverless patterns, compliance frameworks. Built IP Scanner platform scanning 10K+ IPs in under an hour.',
        icon: 'tabler:cloud-lock',
      },
      {
        title: 'People-First Leadership',
        description:
          'Coaching teams to embrace automation. 80% reduction in operational work by teaching teams to automate their own security tasks.',
        icon: 'tabler:users-group',
      },
    ]}
  />

  <!-- Content Widget **************** -->
  <Content
    isReversed
    tagline="Featured Projects"
    title="IP Scanner & Vulnerability Detection Platform"
    items={[
      {
        title: 'High-Performance Architecture',
        description:
          'Originally Python, converted to Go for performance. Leverages SQS and Lambda to scan 10K+ IPs in under an hour.',
      },
      {
        title: 'Comprehensive Scanning',
        description:
          'Actively finds vulnerabilities in corporate environments with both external and internal scanning capabilities.',
      },
      {
        title: 'IPAM Integration',
        description:
          'Aggregates results and integrates with IP Address Management tools for streamlined vulnerability management.',
      },
      {
        title: 'Compliance Automation',
        description:
          'Captures webpage screenshots to validate cookie compliance and track regulatory adherence.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Network Security Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Enterprise-Scale Vulnerability Detection
      </h3>
      Serverless architecture delivering rapid, comprehensive network security scanning
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->
  <Content
    tagline="Featured Projects"
    title="Access Granted: Digital Citizenship Platform"
    items={[
      {
        title: 'Innovative Approach',
        description:
          'Connects firewall management with household chores, teaching children responsibility through positive reinforcement.',
      },
      {
        title: 'Real-world Impact',
        description:
          'Helps families bridge the gap between digital freedom and accountability, turning screen time into teaching moments.',
      },
      {
        title: 'Technical Excellence',
        description:
          'Modern cloud architecture with firewall API integration, real-time sync, and multi-device support.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Digital Citizenship Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Building the Future of Parental Controls
      </h3>
      Empowering children to earn internet access through completing tasks and activities
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-green-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- BlogLatestPost Widget **************** -->
  <BlogLatestPosts
    title="Latest Articles"
    information={`Insights on cybersecurity, security automation, and digital citizenship.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Contact Me',
        href: getPermalink('/contact'),
      },
      {
        variant: 'secondary',
        text: 'View Resume',
        href: getPermalink('/resume'),
      },
    ]}
  >
    <Fragment slot="title">
      Ready to&nbsp;elevate&nbsp;your security posture?
    </Fragment>

    <Fragment slot="subtitle">
      Let's discuss how modern security engineering and automation can transform your organization's security operations.
    </Fragment>
  </CallToAction>
</Layout>
